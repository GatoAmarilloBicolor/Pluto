resource app_signature "application/x-vnd.Hay-pluto";

resource app_version {
	major  = 0,
	middle = 6,
	minor  = 0,
	variety = B_APPV_BETA,
	internal = 1,
	short_info = "Pluto",
	long_info  = "Haiku-native AI client"
};

resource app_flags B_MULTIPLE_LAUNCH;

resource(101, "BEOS:ICON") #'VICN' import "pluto.hvif";
