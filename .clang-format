# .clang-format for Pluto — Haiku-native C++ codebase
# Based on existing style observed across the codebase.

BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
UseTab: Always
TabWidth: 4

# Braces
BreakBeforeBraces: Allman
AllowShortBlocksOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: false
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

# Pointers/references
PointerAlignment: Left
ReferenceAlignment: Left

# Spaces
SpaceAfterTemplateKeyword: false
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 1
SpacesInAngles: false
SpacesInContainerLiterals: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Line length
ColumnLimit: 100

# Access modifiers
AccessModifierOffset: -4
IndentAccessModifiers: true

# Includes
IncludeCategories:
  - Regex: '^<ext/.*\.h>'
    Priority: 1
  - Regex: '^<.*\.h>'
    Priority: 2
  - Regex: '^<.*\.hh>'
    Priority: 2
  - Regex: '^<.*\.hpp>'
    Priority: 2
  - Regex: '^<.*>'
    Priority: 3
  - Regex: '.*'
    Priority: 4
SortIncludes: true

# Other
AllowAllParametersOfDeclarationOnNextLine: true
AllowAllConstructorInitializersOnNextLine: true
AllowBreakAfterNREqualComma: false
AllowBreakBeforeNREqualComma: false
AllowBreakBeforeBinaryOperators: NonAssignment
AllowBreakBeforeTernaryOperators: true
AllowBreakConstructorInitializers: BeforeComma
AllowBreakAfterAssignmentOperator: All
AllowBreakBeforeBitwiseOperators: NonAssignment
AllowBreakBeforeRangeBasedForLoopColon: false
AllowConsecutiveBlankLines: 0
AllowParenBreakAfterStatement: false
AlignAfterOpenBracket: Align
AlignArrayOfStructures: None
AlignEscapedNewlinesLeft: false
AlignOperands: Align
AlignTrailingComments: true
AlwaysBreakAfterDefinitionReturnType: false
AlwaysBreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: true
BinPackParameters: true
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterObjCDeclaration: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
CaseIndentBlocks: false
IndentCaseLabels: false
IndentExternBlock: AfterExternBlock
IndentFunctionDeclarationAfterType: false
IndentPPDirectives: None
IndentQuotes: false
IndentWrappedFunctionNames: false
JavaScriptQuotes: Leave
JavaScriptWrapImports: true
KeepEmptyLinesAtTheStartOfBlocks: false
KeepEmptyLinesAndAffectNonEmptyLines: false
MacroBlockBegin: ''
MacroBlockEnd: ''
MaxEmptyLinesToKeep: 1
NamespaceIndentation: None
PPIndentBehaviors:
  - If: Indent
  - Else: Indent
  - Endif: Outdent
  - Ifdef: Indent
  - Ifndef: Indent
  - Else: Indent
  - Endif: Outdent
  - Define: Indent
  - Undef: Indent
  - Pragma: Indent
  - If: Indent
  - Else: Indent
  - Endif: Outdent
PenaltyBreakAssignment: 2
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyBreakTemplateDeclaration: 10
PenaltyExcessCharacter: 1000000
PenaltyIndentedWhitespace: 0
PenaltyReturnKindOnItsOwnLine: 60
PenaltyBreakParenthesis: 50000
PointerAlignment: Left
RawStringDelimiter: Parentheses
RequireSixteenBitCharacters: false
RequireSixteenBitChars: false
SortUsingDeclarations: true
StatementAttributeLikeMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION
TemplateKeywordAlignment: Left
WhitespaceSensitiveMacros:
  - STRINGIFY
  - PP_STRINGIFY
  - BOOST_PP_STRINGIFY
Standard: Cpp20
