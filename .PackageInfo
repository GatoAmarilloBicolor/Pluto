name             pluto
version          0.7.0-1
architecture     x86_64
summary          "Haiku-native AI client (CLI + GUI + Tracker add-on)"
description      "Pluto is a native Haiku AI client written in C++17 against
libcurl and the Be API. It supports 15+ providers (Anthropic, OpenAI, Gemini,
OpenRouter, Ollama, and more) and ships as three binaries: a streaming REPL
(Pluto_cli), a GUI with multi-tab conversations and markdown rendering (Pluto),
and a Tracker add-on for right-click AI queries (Ask pluto). Features include
23 built-in tools, MCP client, BFS attribute integration, BeAPI RAG, routines,
agent store, and sessions searchable from Tracker Find."
packager         "atomozero <atomozero@example.invalid>"
vendor           "atomozero"
licenses {
	"MIT"
}
copyrights {
	"2026 atomozero"
}
provides {
	pluto = 0.7.0
	cmd:Pluto_cli   = 0.7.0
	app:Pluto       = 0.7.0
}
requires {
	haiku >= r1~beta5
	lib:libcurl
	lib:libcrypto
	lib:libssl
	lib:libedit
}
urls {
	"https://codeberg.org/atomozero/Pluto"
}
